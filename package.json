{
  "name": "openchamber-tps",
  "version": "1.0.0",
  "private": true,
  "description": "Token Speed panel extension for OpenChamber: live turn status for the current session.",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=1.22.0"
    },
    "contributes": {
      "panel": {
        "id": "token-speed",
        "name": "Token Speed",
        "icon": "icon.svg",
        "entry": "panel/index.html"
      }
    }
  },
  "scripts": {
    "build": "openchamber-guest-bundle panel/main.ts panel/main.js"
  },
  "dependencies": {
    "@openchamber/sdk": "1.24.0"
  }
}
